# Copy this file to ".env" (which is git-ignored) for LOCAL development,
# and set the same variable in Railway for production.
#
# Get your keys at https://dashboard.stripe.com/apikeys
# Use the TEST secret key (starts with sk_test_) until you're ready to go live,
# then swap in the LIVE secret key (sk_live_).
STRIPE_SECRET_KEY=sk_test_your_key_here

# --- Admin dashboard secure login (optional but recommended) ---
# Set ADMIN_PASSWORD to turn on the secure login: the dashboard logs in against
# this password (rate-limited) and uses a signed, expiring session token.
# When ADMIN_PASSWORD is set you MUST also set APPS_SCRIPT_KEY to the key your
# Google Apps Script expects (this is your CURRENT admin password) so the server
# can still load signups. Leave both blank to keep the legacy login.
ADMIN_PASSWORD=
APPS_SCRIPT_KEY=

# --- Branded order-confirmation email (optional) ---
# When all of these are set, a paid checkout triggers a branded confirmation
# email to the customer (via the Stripe webhook /api/stripe-webhook). Leave any
# blank and the webhook is a safe no-op.
#
# SMTP_PASS is a Google APP PASSWORD (16 chars) for the SMTP_USER mailbox - NOT
# the normal account password. Generate at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Mail sent this way is DKIM-signed as your domain.
SMTP_USER=info@ecoroundholsters.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_NAME=EcoRound Holsters
# Optional: BCC every confirmation to the owner (a free "new order" copy).
OWNER_EMAIL=info@ecoroundholsters.com

# STRIPE_WEBHOOK_SECRET (whsec_...): from the Stripe Dashboard webhook you create
# pointing at https://www.ecoroundholsters.com/api/stripe-webhook, subscribed to
# the "checkout.session.completed" event. Used to verify the webhook is genuine.
STRIPE_WEBHOOK_SECRET=
